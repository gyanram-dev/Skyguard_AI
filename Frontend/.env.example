[TEMPLATE]
# SkyGuard AI frontend — environment variables.
#
# Base URL of the SkyGuard FastAPI backend (Phase 13 integration).
# The app falls back to http://localhost:8000 when unset.
#
# NEXT_PUBLIC_API_URL is the deployment variable (set it in the Vercel project);
# VITE_API_BASE_URL remains supported for local .env files. Vite inlines either
# value at build time, so redeploy after changing them.
NEXT_PUBLIC_API_URL=http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000
