# SkyGuard AI backend — environment variables.
#
# All variables are optional; defaults target local development.
# Never commit real secrets here (none are required).

# Project root containing data/, models/, reports/ (default: current directory).
SKYGUARD_DATA_ROOT=.

# Bind host/port for `python -m src.api.run` (defaults: 127.0.0.1, 8000).
SKYGUARD_HOST=127.0.0.1
SKYGUARD_PORT=8000

# Comma-separated browser origins allowed to call the API (defaults shown).
SKYGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Live provider. IMD's public WIS2 OGC API currently documents no credentials.
# Set LIVE_SOURCE_MODE=LIVE_IMD and the authorized endpoint to enable polling.
LIVE_SOURCE_MODE=DISABLED
LIVE_PROVIDER=IMD_WIS2
IMD_BASE_URL=
IMD_CA_BUNDLE=
